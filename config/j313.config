# Merged last, after Aurora's config, asahi.config and fedora.config.
# validate-config.py fails the build if Kconfig drops any of these.

# Modules, not built in: /etc/modprobe.d carries the SEP OS identity and
# xart_guard=0, and the force-click options. A built-in driver ignores
# modprobe.d, so Touch ID would lose its identity.
CONFIG_APPLE_SEP=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_BRCMFMAC=m

# Built in on J313, as Aurora's install-aurora-j313.sh expects.
CONFIG_HID_APPLE_MTP_HAPTIC=y

#!/usr/bin/env bash
# Install the newest kernel-aurora-j313 release from GitHub and make it the
# default boot entry. Older Aurora kernels and the stock kernel stay in GRUB.
#   aurora-kernel-update --check     report only (no root needed)
#   pkexec aurora-kernel-update      install
set -euo pipefail

repo=YassinTM/aurora-j313-kernel
keep=2   # kernel-aurora-j313 versions kept installed (plus the running one)
here=$(dirname "$(readlink -f "$0")")

json=$(curl -fsSL --retry 3 "https://api.github.com/repos/$repo/releases/latest") ||
	{ echo "No release found at github.com/$repo (none built yet, or GitHub unreachable)" >&2; exit 1; }
mapfile -t release < <(python3 -I -c '
import json, sys
r = json.load(sys.stdin)
print(r["tag_name"])
for a in r["assets"]:
    if a["name"].endswith(".rpm") or a["name"] == "SHA256SUMS":
        print(a["name"], a["browser_download_url"])' <<<"$json")
tag=${release[0]}
rpm_name=$(printf '%s\n' "${release[@]:1}" | awk '$1 ~ /^kernel-aurora-j313-.*\.rpm$/ {print $1}')
[[ -n $rpm_name ]] || { echo "Release $tag has no kernel RPM" >&2; exit 1; }
nevra=${rpm_name%.rpm}

if rpm -q "$nevra" >/dev/null 2>&1; then
	echo "Up to date: $nevra"
	exit 0
fi
echo "New: $nevra (release $tag, https://github.com/$repo/releases/tag/$tag)"
[[ ${1:-} == --check ]] && exit 0
[[ $(id -u) -eq 0 ]] || { echo 'Install as root: pkexec aurora-kernel-update' >&2; exit 1; }

# Things the Aurora kernel on this Mac depends on.
[[ -s /etc/modprobe.d/aurora-sep-identity.conf ]] ||
	{ echo 'Missing /etc/modprobe.d/aurora-sep-identity.conf (Touch ID identity); stopping' >&2; exit 1; }
hook=/etc/kernel/install.d/12-aurora-dtb-pin.install
if [[ -f $here/12-aurora-dtb-pin.install ]] && ! cmp -s "$here/12-aurora-dtb-pin.install" "$hook"; then
	install -m 0755 "$here/12-aurora-dtb-pin.install" "$hook"
	echo "Updated $hook"
fi
forceclick=/etc/modprobe.d/aurora-j313-forceclick.conf
if [[ ! -e $forceclick ]]; then
	# Packaged kernels get /etc/kernel/cmdline, which lacks these; as module
	# options they apply to every kernel (others ignore unknown ones).
	printf '%s\n' '# Force click = right click (patch 0001 in aurora-j313-kernel)' \
		'options hid_magicmouse haptic_deep_keycode=273 haptic_press=1' >"$forceclick"
	echo "Wrote $forceclick"
fi

free_mb=$(df -Pm /boot | awk 'NR==2 {print $4}')
if (( free_mb < 160 )); then
	echo "/boot has $free_mb MB free; a kernel needs about 160 MB. Remove an old one first:" >&2
	grubby --info=ALL | grep -E '^kernel=' >&2
	exit 1
fi

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
while read -r name url; do
	[[ $name == "$rpm_name" || $name == SHA256SUMS ]] || continue
	curl -fsSL --retry 3 -o "$dir/$name" "$url"
done < <(printf '%s\n' "${release[@]:1}")
(cd "$dir" && grep -F " $rpm_name" SHA256SUMS | sha256sum -c -)
[[ $(rpm -qp --qf '%{NAME} %{ARCH}' "$dir/$rpm_name") == 'kernel-aurora-j313 aarch64' ]]
krel=$(rpm -qp --qf '%{VERSION}-%{RELEASE}.%{ARCH}' "$dir/$rpm_name")

# Aurora renamed the GPU driver asahi -> aurora; only mesa-aurora drives it.
# Fedora Mesa falls back to llvmpipe and niri shows nothing (docs/HANDOFF-mesa-aurora.md).
if rpm -qlp "$dir/$rpm_name" | grep -qE '/drm/asahi/aurora\.ko' &&
	! rpm -q mesa-aurora-dri-drivers >/dev/null 2>&1; then
	echo "$krel needs mesa-aurora (GPU driver is named 'aurora'); install it first, see docs/HANDOFF-mesa-aurora.md" >&2
	exit 1
fi

dnf -y install "$dir/$rpm_name"
test -s "/boot/vmlinuz-$krel" && test -s "/boot/initramfs-$krel.img"
[[ $(readlink /boot/dtb) == "dtb-$krel" ]] || { echo "/boot/dtb is $(readlink /boot/dtb), expected dtb-$krel" >&2; exit 1; }
grubby --set-default "/boot/vmlinuz-$krel"

# Keep the newest $keep packaged kernels; dnf never removes the running one.
mapfile -t old < <(rpm -q kernel-aurora-j313 --qf '%{INSTALLTIME} %{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' |
	sort -rn | awk -v keep="$keep" 'NR > keep {print $2}' | grep -v -- "-$(uname -r)\$" || :)
if (( ${#old[@]} )); then
	dnf -y remove "${old[@]}"
fi

echo
echo "Installed $krel and made it the default. /boot: $(df -h /boot | awk 'NR==2 {print $4}') free."
echo 'Reboot to use it; the previous kernels are still in the GRUB menu.'
